{
  "name": "@crystalgames/adm",
  "version": "0.1.0",
  "description": "ADM developer CLI — environment setup, GitHub integration, and AI-powered daily assistant",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CrystalGamesStudio/ADM-CLI.git"
  },
  "homepage": "https://github.com/CrystalGamesStudio/ADM-CLI#readme",
  "bugs": {
    "url": "https://github.com/CrystalGamesStudio/ADM-CLI/issues"
  },
  "bin": {
    "adm": "./bin/adm"
  },
  "files": [
    "bin/",
    "src/",
    "scripts/completion/",
    "scripts/install.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node ./bin/adm",
    "test": "jest --config=jest.config.js",
    "test:unit": "jest tests/unit --runInBand",
    "test:integration": "jest tests/integration --runInBand",
    "test:shell": "echo 'Install bats separately to run shell tests' && exit 0",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "cli",
    "developer-tools",
    "setup",
    "github",
    "gitlab",
    "ai",
    "adm"
  ],
  "dependencies": {
    "@octokit/rest": "^20.0.2",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "execa": "^7.1.1",
    "ink": "^5.2.1",
    "inquirer": "^8.2.6",
    "ora": "^5.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "jest": "^29.6.0",
    "mock-fs": "^5.2.0",
    "sinon": "^15.2.0"
  }
}
