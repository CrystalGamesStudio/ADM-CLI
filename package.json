{
  "name": "adm-cli",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "adm": "./bin/adm"
  },
  "scripts": {
    "start": "node ./bin/adm",
    "test": "jest --config=jest.config.js",
    "test:unit": "jest tests/unit --runInBand",
    "test:integration": "jest tests/integration --runInBand",
    "test:shell": "echo 'Install bats separately to run shell tests' && exit 0"
  },
  "dependencies": {
    "commander": "^11.1.0",
    "inquirer": "^8.2.6",
    "chalk": "^4.1.2",
    "ora": "^5.4.1",
    "@octokit/rest": "^20.0.2",
    "execa": "^7.1.1"
  },
  "devDependencies": {
    "jest": "^29.6.0",
    "mock-fs": "^5.2.0",
    "sinon": "^15.2.0"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": ["<rootDir>/tests/setup-jest.js"]
  }
}
