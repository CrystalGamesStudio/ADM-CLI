#!/usr/bin/env node
const { Command } = require('commander');
const chalk = require('chalk');
const { handleAdmError, formatError } = require('../src/utils/error-handler');
const { runSetup } = require('../src/setup/wizard');
const { runInstallers } = require('../src/installers');
const { connectGithub, connectGitlab, listConnections, disconnect } = require('../src/commands/connect');
const { listPRs, draftPR, commentPR } = require('../src/commands/pr');
const { listMRs, draftMR, commentMR } = require('../src/commands/mr');
const { listIssues } = require('../src/commands/issue');
const { syncDotfilesCommand } = require('../src/commands/dotfiles');
const { uninstall } = require('../src/commands/uninstall');
const { readConfig } = require('../src/config');
const { start: startAssistant } = require('../src/commands/assistant');
const { themeCommand } = require('../src/commands/theme');

const program = new Command();
program
  .name('adm')
  .description('ADM developer CLI — setup, GitHub integration, and daily assistant')
  .version(require('../package.json').version);

function exitWithError(err) {
  const admErr = handleAdmError(err);
  console.error(chalk.red(formatError(admErr)));
  process.exit(admErr.exitCode);
}

// ── adm setup ──────────────────────────────────────────────
program
  .command('setup')
  .description('Run interactive setup wizard')
  .option('--dry-run', 'Preview planned actions without executing')
  .action(async (opts) => {
    try {
      const res = await runSetup({ dryRun: !!opts.dryRun });
      if (opts.dryRun) console.log(JSON.stringify(res, null, 2));
    } catch (err) {
      exitWithError(err);
    }
  });

// ── adm installers ─────────────────────────────────────────
program
  .command('installers')
  .description('Plan or run environment installers')
  .option('--dry-run', 'Plan only, do not execute')
  .option('--execute', 'Execute installers (requires ADM_EXECUTE=1)')
  .action(async (opts) => {
    const execute = !!opts.execute;
    if (execute && process.env.ADM_EXECUTE !== '1') {
      console.error(chalk.red('Refusing to execute: set ADM_EXECUTE=1 to confirm'));
      process.exit(2);
    }
    try {
      const res = await runInstallers({ dryRun: !!opts.dryRun, execute });
      console.log(JSON.stringify(res, null, 2));
    } catch (err) {
      exitWithError(err);
    }
  });

// ── adm connect ────────────────────────────────────────────
const connectCmd = program
  .command('connect')
  .description('Manage service connections');

connectCmd
  .command('github')
  .description('Connect GitHub account (PAT token)')
  .option('--token <token>', 'GitHub PAT token (will prompt if omitted)')
  .action(async (opts) => {
    try {
      await connectGithub({ token: opts.token });
    } catch (err) {
      exitWithError(err);
    }
  });

connectCmd
  .command('gitlab')
  .description('Connect GitLab account (access token)')
  .option('--token <token>', 'GitLab access token (will prompt if omitted)')
  .action(async (opts) => {
    try {
      await connectGitlab({ token: opts.token });
    } catch (err) {
      exitWithError(err);
    }
  });

connectCmd
  .command('list')
  .description('List connected services')
  .action(async () => {
    try {
      await listConnections();
    } catch (err) {
      exitWithError(err);
    }
  });

connectCmd
  .command('disconnect <service>')
  .description('Disconnect a service (github)')
  .action(async (service) => {
    try {
      await disconnect(service);
    } catch (err) {
      exitWithError(err);
    }
  });

// ── adm pr ─────────────────────────────────────────────────
const prCmd = program
  .command('pr')
  .description('Manage pull requests');

prCmd
  .command('list')
  .description('List open pull requests')
  .option('--repo <repo>', 'Filter by repo (owner/name)')
  .option('--limit <n>', 'Max results', '20')
  .action(async (opts) => {
    try {
      await listPRs({ repo: opts.repo, limit: parseInt(opts.limit, 10) });
    } catch (err) {
      exitWithError(err);
    }
  });

prCmd
  .command('draft <title>')
  .description('Create a draft PR from the current branch')
  .option('--base <branch>', 'Base branch', 'main')
  .action(async (title, opts) => {
    try {
      await draftPR(title, { base: opts.base });
    } catch (err) {
      exitWithError(err);
    }
  });

prCmd
  .command('comment <pr> <message>')
  .description('Comment on a pull request')
  .action(async (pr, message) => {
    try {
      await commentPR(parseInt(pr, 10), message);
    } catch (err) {
      exitWithError(err);
    }
  });

// ── adm mr ─────────────────────────────────────────────────
const mrCmd = program
  .command('mr')
  .description('Manage merge requests (GitLab)');

mrCmd
  .command('list')
  .description('List open merge requests')
  .option('--limit <n>', 'Max results', '20')
  .action(async (opts) => {
    try {
      await listMRs({ limit: parseInt(opts.limit, 10) });
    } catch (err) {
      exitWithError(err);
    }
  });

mrCmd
  .command('draft <title>')
  .description('Create a draft MR on GitLab')
  .option('--project-id <id>', 'GitLab project ID')
  .option('--source-branch <branch>', 'Source branch')
  .action(async (title, opts) => {
    try {
      await draftMR(title, { projectId: parseInt(opts.projectId, 10), sourceBranch: opts.sourceBranch });
    } catch (err) {
      exitWithError(err);
    }
  });

mrCmd
  .command('comment <mr> <message>')
  .description('Comment on a merge request')
  .option('--project-id <id>', 'GitLab project ID')
  .action(async (mr, message, opts) => {
    try {
      await commentMR(parseInt(mr, 10), message, { projectId: parseInt(opts.projectId, 10) });
    } catch (err) {
      exitWithError(err);
    }
  });

// ── adm issue ──────────────────────────────────────────────
program
  .command('issue-list')
  .description('List issues from connected platforms (GitHub / GitLab)')
  .option('--platform <platform>', 'Filter by platform (github / gitlab)')
  .option('--limit <n>', 'Max results', '20')
  .action(async (opts) => {
    try {
      await listIssues({ platform: opts.platform, limit: parseInt(opts.limit, 10) });
    } catch (err) {
      exitWithError(err);
    }
  });

// ── adm dotfiles ─────────────────────────────────────────────
const dotfilesCmd = program
  .command('dotfiles')
  .description('Manage dotfiles sync');

dotfilesCmd
  .command('sync')
  .description('Clone/pull dotfiles repo and symlink files')
  .option('--repo <url>', 'Dotfiles repo URL (overrides config)')
  .option('--copy', 'Copy files instead of symlinking')
  .option('--only <files>', 'Sync only specified files (comma-separated, e.g. bashrc,zshrc)')
  .action(async (opts) => {
    try {
      const only = opts.only ? opts.only.split(',') : undefined;
      await syncDotfilesCommand({ repo: opts.repo, copy: opts.copy, only });
    } catch (err) {
      exitWithError(err);
    }
  });

// ── adm theme ───────────────────────────────────────────────
program
  .command('theme')
  .description('Choose a color theme')
  .action(async () => {
    try {
      await themeCommand();
    } catch (err) {
      exitWithError(err);
    }
  });

// ── adm uninstall ──────────────────────────────────────────
program
  .command('uninstall')
  .description('Remove ADM config and references')
  .action(async () => {
    try {
      await uninstall();
    } catch (err) {
      exitWithError(err);
    }
  });

// ── adm assistant (default when no args) ────────────────────
program
  .command('assistant')
  .description('Launch interactive assistant shell')
  .option('--api-key <key>', 'GLM API key (overrides default)')
  .action(async (opts) => {
    try {
      const config = await readConfig();
      const context = {
        apiKey: opts.apiKey || null,
        config,
      };
      await startAssistant(context);
    } catch (err) {
      exitWithError(err);
    }
  });

// Default to TUI when no subcommand given (but not for unknown commands)
const firstArg = process.argv[2];
if (!firstArg) {
  const { boot } = require('../src/tui/app');
  boot().catch(err => {
    console.error(chalk.red(err.message));
    process.exit(1);
  });
  return;
}

// ── Plugin fallback: nieznana komenda → sprawdź wtyczki ──
const { tryRunPlugin } = require('../src/plugins/runner');

program.on('command:*', async (operands) => {
  const cmdName = operands[0];
  const args = operands.slice(1).join(' ');
  try {
    const output = await tryRunPlugin(cmdName, args);
    if (output !== null) {
      console.log(output);
      return;
    }
    console.error(chalk.red(`Unknown command: ${cmdName}. Run ${chalk.bold('adm --help')} for available commands.`));
    process.exit(1);
  } catch (err) {
    exitWithError(err);
  }
});

program.parseAsync(process.argv).catch(err => {
  exitWithError(err);
});
